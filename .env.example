# Copy this file to .env for local use, or add the same names in Vercel > Settings > Environment Variables.
# Set at least one key. Both have free tiers.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
# Which provider to try first (comma-separated): gemini,groq
LLM_ORDER=gemini,groq
# Lock the public API to your site (recommended on Vercel)
ALLOWED_ORIGINS=https://medicore-psi.vercel.app
RATE_LIMIT_PER_MIN=40
PORT=3000
